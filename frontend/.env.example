# Leave empty in development to use the Vite proxy (/api -> http://localhost:5000).
# In production set to the full API origin, e.g. https://api.yourdomain.com
VITE_API_URL=
# Public site origin used for canonical / Open Graph URLs
VITE_SITE_URL=http://localhost:5173
# Optional reCAPTCHA site key (backend needs CAPTCHA_SECRET_KEY)
VITE_RECAPTCHA_SITE_KEY=
