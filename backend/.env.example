# ---- Server ----
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
# Comma-separated list of allowed browser origins (defaults to FRONTEND_URL)
CORS_ORIGINS=http://localhost:5173

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/pharma_website

# ---- Auth (generate with: openssl rand -base64 48) ----
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=7d

# ---- Email (leave SMTP_HOST empty to log emails to console) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com
ENQUIRY_EMAIL=sales@example.com
CAREERS_EMAIL=careers@example.com

# ---- Storage ----
# local = writes to ./uploads (public/ served at /uploads, private/ never served)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_PUBLIC_BASE_URL=
# For S3-compatible providers (when a cloud provider is implemented/selected):
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
MAX_UPLOAD_MB=10

# ---- Anti-spam (optional; reCAPTCHA v2/v3 secret; empty = disabled) ----
CAPTCHA_SECRET_KEY=
